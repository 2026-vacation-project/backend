# JWT 설정
SECRET_KEY=change_this_to_a_secure_random_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7

# PostgreSQL
DATABASE_URL=postgresql+psycopg://teammoa:teammoa@localhost:5432/teammoa

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback/google

# Discord OAuth
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
DISCORD_REDIRECT_URI=http://localhost:3000/auth/callback/discord

# IGDB 동기화 전용
TWITCH_CLIENT_ID=twitch_client_id_here
TWITCH_CLIENT_SECRET=twitch_client_secret_here
